ENV=<develop|testing|production>

POSTGRES_USER=<superusuario-de-postgres>
POSTGRES_DB=<nombre-de-la-base>

POSTGRES_MAX_CONNECTIONS=<max_connections, p.ej. 200>
POSTGRES_SHARED_BUFFERS=<shared_buffers, p.ej. 2GB>
POSTGRES_EFFECTIVE_CACHE_SIZE=<effective_cache_size, p.ej. 5632MB>

AO_ENDPOINT=<url-del-s3-del-acervo>
AO_BUCKET=<bucket-de-respaldos, p.ej. dataengine>
AO_ACCESS_KEY=<access-key-del-usuario-de-respaldos-en-acervo>
AO_SECRET_KEY=<secret-key-del-usuario-de-respaldos-en-acervo>
# Llave publica age (age1...) con la que se cifran los respaldos antes de subirlos al Acervo.
# La privada no vive en el servidor: sin ella no se puede restaurar lo que esta en el bucket.
BACKUP_AGE_RECIPIENT=<llave-publica-age-de-los-respaldos>

MAPALAB_AO_BUCKET=<bucket-de-mapalab-en-acervo>

GEOSERVER_URL=<url-base-de-sextante-con-el-context-root>

PG_PRIMARY_PORT=<puerto-publicado-del-primary>
POSTGRES_PRIMARY_DATA=<ruta-del-volumen-del-primary, p.ej. ./volumes/postgres-primary>
PG_BIND_ADDRESS=<internal-interface-ip>
PGDATA=<ruta-de-datos-dentro-del-contenedor>
BACKUP_DATA=<ruta-de-los-respaldos-locales, p.ej. ./volumes/backups>
BACKUP_UID=<uid-dueno-de-los-respaldos-locales>
BACKUP_GID=<gid-dueno-de-los-respaldos-locales>

ALLOWED_HOSTS="<cidr-de-cada-cliente-externo-separados-por-espacio>"
# Subred fija de dataengine-network: es la unica red docker que pg_hba acepta, y solo con SSL
DATAENGINE_NETWORK_SUBNET=<cidr-de-dataengine-network, p.ej. 172.27.0.0/24>
# Subredes fijas de las otras dos redes. Sin ellas compose las crea a la vez que dataengine-network
# y una puede quedarse con su subred. Las tres, fuera de los default-address-pools del daemon
DATAENGINE_ONTOY_SUBNET=<cidr-de-dataengine-ontoy-network>
DATAENGINE_DOCKER_API_SUBNET=<cidr-de-dataengine-docker-api>
# gid del grupo dueno de secrets/: pgbouncer corre como uid 70 y lee los secrets por grupo
DATAENGINE_SECRETS_GID=<gid-del-grupo-dueno-de-secrets>

# pgbouncer solo escucha en 127.0.0.1 del nodo
PGBOUNCER_PORT=<puerto-local-de-pgbouncer>

VERSION_API_PORT=<puerto-publicado-del-ontoy, p.ej. 8088>
ONTOY_DISK_PATH=<ruta-del-filesystem-que-se-mide>

# Contrato /ontoy: nodo al que pertenece y quien reporta el host.
# Solo UN servicio por nodo lleva ONTOY_NODE_REPORTER=true.
ONTOY_NODE=<nodo donde corre, p.ej. S4>
ONTOY_NODE_REPORTER=<true en el reportero del nodo, false en los demas>
ONTOY_PEER_CHECKS=<S1=10.0.0.1:8088>
