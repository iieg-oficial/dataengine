ENV=develop|testing|production

POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=name

AO_ENDPOINT=https://your-storage-endpoint.com
AO_BUCKET=dataengine-backups
AO_ACCESS_KEY=your_access_key
AO_SECRET_KEY=your_secret_key

PG_PRIMARY_PORT=port
POSTGRES_PRIMARY_DATA=./volumes/postgres-primary
PG_BIND_ADDRESS=<host>
PGDATA=/path/data
BACKUP_DATA=./volumes/backups

ALLOWED_HOSTS=1.0.2.3/32 1.1.1.0/24

CRON_SCHEDULE=hour:minute

PGBOUNCER_PORT=port
