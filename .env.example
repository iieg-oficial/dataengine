# PostgreSQL Primary
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=name

# Replication
REPLICATION_USER=replicator
REPLICATION_PASSWORD=changeme_repl_password

# Acervo de Objetos (AO)
AO_ENDPOINT=https://your-storage-endpoint.com
AO_BUCKET=dataengine-backups
AO_ACCESS_KEY=your_access_key
AO_SECRET_KEY=your_secret_key

# Ports
PG_PRIMARY_PORT=port
PG_REPLICA_PORT=port
